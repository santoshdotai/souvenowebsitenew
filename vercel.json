{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "souveno.in" }], "destination": "https://www.souveno.ai/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.souveno.in" }], "destination": "https://www.souveno.ai/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "souveno.ai" }], "destination": "https://www.souveno.ai/:path*", "permanent": true }
  ]
}
